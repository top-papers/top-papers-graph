{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://top-papers.example/schemas/vlm-ab-publication-provenance-row-v1.json",
  "title": "Publication VLM image provenance row",
  "description": "Exactly one row is required per benchmark sample_id.",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "nonBlankString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "trimmedIdentifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "reviewerIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/+ -]*[A-Za-z0-9])?$"
    }
  },
  "required": ["sample_id", "paper_id", "images"],
  "properties": {
    "sample_id": {"$ref": "#/$defs/trimmedIdentifier"},
    "paper_id": {"$ref": "#/$defs/trimmedIdentifier"},
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "image_path",
          "sha256",
          "page",
          "locator",
          "source_url",
          "license",
          "verified_by"
        ],
        "properties": {
          "image_path": {"$ref": "#/$defs/nonBlankString"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "page": {
            "anyOf": [
              {"type": "integer"},
              {"$ref": "#/$defs/nonBlankString"}
            ]
          },
          "locator": {"$ref": "#/$defs/nonBlankString"},
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "license": {"$ref": "#/$defs/nonBlankString"},
          "verified_by": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/reviewerIdentifier"}
          },
          "citation": {"$ref": "#/$defs/nonBlankString"}
        }
      }
    }
  }
}
